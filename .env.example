# Copia este archivo como .env y llena tus claves. El .env NUNCA se sube a GitHub.

# Token del bot (lo da @BotFather en Telegram)
TELEGRAM_TOKEN=

# Clave de Gemini: https://aistudio.google.com  (Crear clave de API, proyecto gratuito)
GEMINI_API_KEY=

# Clave de Groq (último respaldo): https://console.groq.com/keys
GROQ_API_KEY=

# ---- Opcionales (si no se ponen, se usan estos valores) ----
# Cadena de respaldo, en orden: primero los Gemini, después los Groq.
# GEMINI_MODELOS=gemini-3.5-flash,gemini-3.7-flash,gemini-3.8-flash
# GROQ_MODELOS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# Segundos máximos de espera por cada intento y por todo un mensaje.
# LLM_TIEMPO_POR_INTENTO=12
# LLM_TIEMPO_POR_TURNO=60

# Solo para la demo: hace "fallar" a propósito a un proveedor para mostrar el paso a Groq.
# LLM_SIMULAR_FALLO=gemini
